{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-manifest.schema.json",
  "title": "DMF Agent Manifest",
  "description": "Schema for the DMF agent-manifest.json file. Validates both bootstrapped (unpopulated) and populated states.",
  "type": "object",
  "required": ["manifest_version", "_DMF_global", "project", "agent_contract", "provenance", "versioning"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema self-reference pointer."
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this manifest file."
    },
    "_DMF_global": {
      "type": "object",
      "description": "Persistent owner defaults. These travel with every project and are not modified during bootstrap.",
      "required": ["owner", "defaults"],
      "additionalProperties": true,
      "properties": {
        "_comment": { "type": "string" },
        "owner": {
          "type": "object",
          "required": ["name", "contact"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "contact": { "type": "string", "format": "email" }
          },
          "additionalProperties": false
        },
        "defaults": {
          "type": "object",
          "required": ["license", "versioning_scheme", "timestamp_format", "hash_algorithm", "inference_posture", "authority_model"],
          "properties": {
            "license": { "type": "string" },
            "versioning_scheme": { "type": "string", "enum": ["semver", "calver", "custom"] },
            "timestamp_format": { "type": "string" },
            "hash_algorithm": { "type": "string" },
            "changelog": { "type": "string" },
            "inference_posture": {
              "type": "string",
              "enum": ["labeled", "conservative", "permissive"],
              "description": "labeled = infer but always label. conservative = minimize inference. permissive = infer freely."
            },
            "authority_model": {
              "type": "string",
              "enum": ["three-tier"],
              "description": "Trust hierarchy model. Currently only three-tier is defined."
            }
          },
          "additionalProperties": false
        }
      }
    },
    "_DMF_initial": {
      "type": "object",
      "description": "Bootstrap directives. Presence of this key signals unpopulated state. Removed after bootstrap approval.",
      "properties": {
        "_comment": { "type": "string" },
        "directive": { "type": "string", "minLength": 1 },
        "discovery_hints": {
          "type": "object",
          "description": "Glob patterns for discovering project artifacts by category.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "stack_hints": {
          "type": "object",
          "description": "Project-specific discovery patterns added during bootstrap. Do not modify master template.",
          "additionalProperties": true
        }
      },
      "required": ["directive", "discovery_hints"],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "description": "Project identity and entry points.",
      "required": ["name", "repo_root", "readme", "agents_doc"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "repo_root": { "type": "string", "default": "." },
        "primary_language": { "type": "string" },
        "framework": { "type": "string" },
        "readme": { "type": "string", "default": "README.md" },
        "agents_doc": { "type": "string", "default": "AGENTS.md" }
      },
      "additionalProperties": false
    },
    "agent_contract": {
      "type": "object",
      "description": "Pointers to agent-facing contract artifacts.",
      "properties": {
        "prompt_pack": {
          "type": "string",
          "description": "Path to the prompt pack file or directory."
        },
        "policies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths to policy documents."
        },
        "schemas": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths to JSON Schema files for output validation."
        },
        "state_snapshot": {
          "type": "string",
          "description": "Path to the current state snapshot file."
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "description": "Tool specifications available to agents.",
      "items": {
        "type": "object",
        "required": ["tool_id"],
        "properties": {
          "tool_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "openapi": {
            "type": "string",
            "description": "Path to OpenAPI spec for this tool."
          },
          "auth": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "scopes": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          },
          "constraints": {
            "type": "object",
            "description": "Usage constraints (rate limits, allowed verbs, etc.).",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "description": "Provenance and audit configuration.",
      "required": ["timestamp_format", "hash"],
      "properties": {
        "run_manifest_dir": { "type": "string" },
        "timestamp_format": { "type": "string" },
        "hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "versioning": {
      "type": "object",
      "description": "Versioning configuration for the project.",
      "required": ["scheme"],
      "properties": {
        "scheme": { "type": "string" },
        "changelog": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
