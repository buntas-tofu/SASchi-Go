/* Original first-party grouped-control state and event witness. */
data seed(keep=key x total);
do;
  key=1; x=2; total=10; output;
  key=2; x=.; total=.; output;
  key=3; x=4; total=20; output;
end;
run;

data measured(keep=key total accumulated scratch i j phase);
retain accumulated 0;
set seed;
phase=0;
do i=1 to 3;
  do;
    if i=2 then continue;
    total+x;
    if key=2 then leave;
    if i=1 then do;
      scratch=total;
      output;
    end;
  end;
end;
phase=1;
j=0;
do until(j>=2);
  do;
    j=j+1;
    if j=1 then continue;
    total+1;
  end;
end;
accumulated+total;
output;
put key total accumulated i j;
run;

data fresh(keep=answer idx);
answer=0;
do idx=3 to 1 by -1;
  do;
    if idx=2 then continue;
    answer+idx;
  end;
end;
do;
  output;
end;
put answer idx;
run;
