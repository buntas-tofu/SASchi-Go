data batch_summary;
  length batch_label $24;
  length status $8;
  retain seen 0;
  retain accepted 0;
  retain rejected 0;
  retain net 0;
  retain magnitude 0;
  retain worst 0;
  set ledger;
  by batch;
  batch_label=upcase(compbl(strip(label)));
  if first.batch then do;
    seen=0;
    accepted=0;
    rejected=0;
    net=0;
    magnitude=0;
    worst=0;
  end;
  seen+1;
  if n(amount,expected)=2 then do;
    delta=amount-expected;
    accepted+1;
    net+delta;
    magnitude+abs(delta);
    worst=max(worst,abs(delta));
  end;
  else rejected+1;
  if last.batch then do;
    status=ifc(rejected=0 and worst<=limit,'READY','REVIEW');
    output;
  end;
run;

data review_batches;
  set batch_summary;
  where status='REVIEW';
run;
