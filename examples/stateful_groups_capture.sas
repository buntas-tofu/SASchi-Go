data grouped_rows;
  length canon $24;
  length phase $8;
  retain peak 0;
  retain total 0;
  set raw;
  by batch;
  canon=upcase(compbl(dequote(strip(code))));
  if first.batch then do;
    peak=0;
    total=0;
  end;
  total+abs(amount-expected);
  peak=max(peak,abs(amount-expected));
  if first.batch and n(amount,expected)<2 then do;
    phase='FIRST';
    output;
  end;
  if last.batch then do;
    phase=ifc(total>5 or n(amount,expected)<2,'REVIEW','READY');
    output;
  end;
  put 'group';
run;
