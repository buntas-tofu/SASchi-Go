data reconciled;
set raw;
quarter=qtr(day);
stamp=dhms(day,hr,mn,sc);
recovered=datepart(stamp);
clock=timepart(stamp);
h=hour(stamp);
m=minute(stamp);
s=second(stamp);
yr=year(recovered);
mo=month(recovered);
dy=day(recovered);
mid=median(a,b,c);
spread=range(a,b,c);
variance=var(a,b,c);
deviation=std(a,b,c);
average=mean(a,b,c);
magnitude=abs(average);
period=intnx('MONTH',recovered,0,'B');
months=intck('MONTH',0,recovered);
if missing(a)=1 then absent=1;
else absent=0;
shown=put(recovered,date9.);
output;
put shown;
put absent;
run;
