data decision_rows;
  length canon $24;
  length phase $8;
  length choice $8;
  set raw;
  canon=upcase(compbl(dequote(strip(code))));
  invalid=notalnum(strip(canon))>0 or lengthn(strip(canon))=0;
  count=n(amount,expected);
  difference=amount-expected;
  magnitude=abs(difference);
  scale=max(abs(amount),abs(expected));
  choice=ifc(count=2 and magnitude<=5,'SMALL','REVIEW');
  if invalid then do;
    phase='ID';
    output;
  end;
  if count=2 and magnitude>2 then do;
    phase='VALUE';
    output decision_rows;
    difference=0;
  end;
  if not invalid and count=2 and magnitude<=2 then do;
    phase='PASS';
    output;
  end;
  tail=42;
  put 'decision';
run;
