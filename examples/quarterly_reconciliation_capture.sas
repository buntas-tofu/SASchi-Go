data quarters;
set raw;
clock=hms(hr,mn,sc);
quarterdate=yyq(yr,q);
observed=datejul(ordinal);
back=juldate7(observed);
quarterback=juldate7(quarterdate);
year=year(observed);
month=month(observed);
day=day(observed);
quarter=qtr(observed);
stamp=dhms(observed,hr,mn,sc);
recovered=datepart(stamp);
time=timepart(stamp);
present=n(a,b,c);
absent=nmiss(a,b,c);
high=largest(k,a,b,c);
low=smallest(k,a,b,c);
centered=css(a,b,c);
uncentered=uss(a,b,c);
chosen=ifn(flag,fallback,largest(k,a,b,c));
raised=ceilz(value);
lowered=floorz(value);
integral=intz(value);
rounded=roundz(value,unit);
remainder=modz(value,divisor);
if missing(a)=1 then a_missing=1;
else a_missing=0;
shown=put(observed,date9.);
output;
put shown;
put time;
put chosen;
run;
