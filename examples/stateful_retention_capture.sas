data retained_rows;
  length canon $24;
  length trace $8;
  retain peak 0;
  retain seen 10;
  retain pending .;
  set raw;
  canon=upcase(compbl(dequote(strip(code))));
  if n(amount,expected)=2 then do;
    scratch=abs(amount-expected);
    peak=max(peak,scratch);
    seen=seen+1;
    pending=peak;
  end;
  trace=ifc(n(amount,expected)=2,'READ','MISS');
  output;
  if n(amount,expected)<2 then do;
    scratch=99;
    output;
  end;
  put 'retained';
run;
