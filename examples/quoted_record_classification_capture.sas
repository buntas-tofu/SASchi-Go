data records;
set raw;
proper=propcase(label,' -');
wrapped=quote(code);
bare=dequote(code);
marks=countc(label,'-');
cleaned=transtrn(label,'-',trimn(' '));
identifier=cats(propcase(label,' -'),'-',dequote(code));
upperpos=anyupper(code);
lowerpos=anylower(code);
badpos=notalnum(code);
look=whichc(bare,'A','B','A');
rank=whichn(flag,0,1,1);
picked=choosec(index,'FIRST','SECOND','THIRD');
amount=choosen(index,a,b,c);
decision=ifc(notalnum(code)=0,'OK','REVIEW');
chosen=ifn(flag,fallback,largest(k,a,b,c));
if anyupper(code)>0 then has_upper=1;
else has_upper=0;
if missing(label)=1 then blank=1;
else blank=0;
output;
put identifier;
put decision;
put chosen;
run;
